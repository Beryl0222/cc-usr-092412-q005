{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "更年期研究释义台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STUDY_REGISTERED",
        "CLAIM_MAPPED",
        "MATERIAL_DRAFTED",
        "CHECKS_RECORDED",
        "SIGNOFF_RECORDED",
        "CONTENT_APPROVED",
        "CONTENT_DISTRIBUTED",
        "MATERIAL_FLAGGED",
        "MATERIAL_REVISED",
        "EVIDENCE_UPDATED",
        "CORRECTION_PUBLISHED",
        "RECEIPT_CONFIRMED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "research_study",
        "public_claim",
        "content_variant",
        "correction_notice"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
